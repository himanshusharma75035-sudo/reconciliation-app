# ── Eko Recon — Environment Configuration ────────────────────────────────────
# Copy this file to .env and set real values. Every variable is optional for
# local development EXCEPT SECRET_KEY, which you must set before any real use.

# JWT signing secret — REQUIRED. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret-string

# Database — omit for local SQLite (backend/recon.db is created automatically).
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/eko_recon
# DATABASE_URL=postgresql://user:password@localhost:5432/recon_db

# Allowed CORS origins, comma-separated. Defaults to localhost dev origins.
# ALLOWED_ORIGINS=https://recon.example.com

# API rate limit (requires `pip install slowapi`; disabled gracefully if absent)
# RATE_LIMIT=120/minute

# ── Email notifications (optional — leave blank to disable) ──────────────────
# Any SMTP server works (Gmail, Office365, custom relay).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Comma-separated recipients for the daily end-of-day summary email
EOD_EMAIL_TO=
# Daily EOD summary send time (IST, 24h)
EOD_EMAIL_HOUR=19
EOD_EMAIL_MINUTE=0
# Alert if any partner's match rate drops below this percentage (0–100)
MATCH_RATE_ALERT_THRESHOLD=90

# ── E-Value watch folder (optional) ──────────────────────────────────────────
# Folder scanned daily for E-Value statements; leave unset to disable.
# EVALUE_WATCH_FOLDER=C:\recon\evalue-inbox
# EVALUE_WATCH_HOUR=7
# EVALUE_WATCH_MINUTE=30

# ── Developer Portal AI agent (optional — leave blank to disable the agent) ──
# Anthropic API key for the read-only Developer Portal agent (Phase 2).
# The agent is READ-ONLY: it can answer questions over the codebase and live DB
# but cannot write to any table. Get a key at https://console.anthropic.com .
# NEVER commit the real key — it lives only in backend/.env (gitignored).
ANTHROPIC_API_KEY=
# Model + reasoning effort for the agent (defaults shown).
PORTAL_AGENT_MODEL=claude-opus-4-8
PORTAL_AGENT_EFFORT=high

# ── Builder Agent (Phase 5 — WRITE-CAPABLE, autonomous) ──────────────────────
# DANGER: when enabled, the Builder Agent can create/edit/delete application code
# (everything except secrets) and — once its change passes ALL gates (pytest,
# compileall, npm build, ruff, behavior-contract) — apply it to the running app.
# This is a real-money reconciliation system. Keep this OFF unless you mean it.
# Master kill-switch — the entire write capability is disabled unless this is 1.
BUILDER_AGENT_ENABLED=0
# If 1, a change that passes the gates is applied automatically (no human click).
# Leave 0 so a human clicks "Apply" after reviewing the diff and gate results.
BUILDER_AUTO_APPLY=0
# Optional model/effort overrides (fall back to the read-only agent's settings).
BUILDER_AGENT_MODEL=claude-opus-4-8
BUILDER_AGENT_EFFORT=high
# Canary: boot the built code on a temp DB before a change can pass the gates (1=on).
BUILDER_SMOKE_BOOT=1
# Post-apply health watchdog: seconds to wait, then auto-rollback if health regressed.
BUILDER_WATCHDOG_SECONDS=600
# Optional Slack webhook for builder notifications (apply / auto-rollback).
BUILDER_SLACK_WEBHOOK=
# Optional remote-deploy command (build + scp + restart the server). Leave blank to
# keep the "Deploy" button disabled. The app never stores server credentials itself.
BUILDER_DEPLOY_COMMAND=
